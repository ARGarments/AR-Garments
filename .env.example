# ImageKit Configuration for AR Garment E-Commerce
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# Razorpay Payment Gateway (server-side only)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_long_random_webhook_secret

# Brevo passwordless email login and registration (server-side only)
BREVO_API_KEY=xkeysib-your_api_key
BREVO_SENDER_EMAIL=no-reply@your-domain.com
BREVO_SENDER_NAME=AR Garments

# Used to sign sessions and hash one-time authentication codes
AUTH_SECRET=replace_with_a_long_random_secret
